# agent-broker — host-side model-call proxy. Holds the ONLY copy of the key.

# Postgres (same DB as the rest of the platform). Without it the broker refuses
# all calls, since it can't enforce the cap.
DATABASE_URL=postgres://user:pass@localhost:5432/foxplay?sslmode=disable

# Upstream provider keys. Never injected into a VM — the broker holds them and
# picks one per request based on the agent's runtime (claude -> anthropic,
# chatgpt -> openai). Set the keys for whichever engine builds you deploy.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

# Host-local control plane the agent-manager calls to (de)register VMs.
CONTROL_ADDR=127.0.0.1:8090

# Guest connects to CID 2 on this vsock port; Firecracker maps it to
# "<vsock_path>_<port>" on the host, where the broker listens per VM.
AGENT_BROKER_VSOCK_PORT=9000

# Flat USD reserved per model call, reconciled to actual afterwards.
RESERVE_USD=0.10

# Per-million-token price table. Copy prices.example.json -> prices.json.
PRICES_PATH=prices.json
