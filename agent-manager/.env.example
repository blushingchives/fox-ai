# agent-manager — owns sticky per-agent Firecracker VMs.

DATABASE_URL=postgres://user:pass@localhost:5432/foxplay?sslmode=disable

# Kernel + images. AGENT_BASE_ROOTFS embeds the agent bootstrap at
# /var/runtime/bootstrap. AGENT_RUNTIME_DIR holds one engine build image per
# runtime, named <runtime>.ext4 — e.g. claude.ext4, chatgpt.ext4. The agent's
# `runtime` column selects which one boots.
KERNEL_PATH=/tmp/fc/vmlinux.bin
AGENT_BASE_ROOTFS=/tmp/agent-base.ext4
AGENT_RUNTIME_DIR=/tmp/agent-runtimes

# Per-STORAGE writable ext4 drives live here (keyed by storage id, created on
# first boot, reused after — portable across engine builds).
AGENT_DATA_DIR=/tmp/agent-data
DATA_DRIVE_SIZE_MB=2048

FIRECRACKER_BIN=firecracker
VCPU_COUNT=1
MEM_MIB=1024

# Broker control plane (same host) for VM (de)registration.
BROKER_CONTROL_URL=http://127.0.0.1:8090

# Evict idle VMs after this long (state persists on the data drive).
IDLE_TIMEOUT_SECONDS=300
# Max wall-clock for one agent turn (replaces pool-manager's fixed 30s).
INVOKE_TIMEOUT_SECONDS=600
# VM-lifecycle lease so two hosts can't run the same agent.
LEASE_TTL_SECONDS=120

# Identifies this host in the agents.owner_host lease (defaults to hostname).
# HOST_ID=

LISTEN_ADDR=:8080
